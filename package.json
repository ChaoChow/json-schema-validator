{
  "name": "@chaochow/json-schema-validator",
  "version": "0.1.0",
  "description": "Package that validates JSON against JSON Schema",
  "author": "Qiaochu Tang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChaoChow/json-schema-validator.git"
  },
  "homepage": "https://github.com/ChaoChow/json-schema-validator#readme",
  "bugs": {
    "url": "https://github.com/ChaoChow/json-schema-validator/issues"
  },
  "keywords": [
    "json-schema",
    "json",
    "schema",
    "validator",
    "validation"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "npm@12.0.2",
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage",
    "prepublishOnly": "npm run clean && npm run check && npm run build",
    "publish:npm": "npm publish"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
